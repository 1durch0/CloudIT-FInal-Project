server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    location /api/auth/ {
        proxy_pass ${AUTH_SERVICE_BASE}/api/;
        proxy_set_header Host ${AUTH_SERVICE_HOST};
        proxy_ssl_server_name on;
    }

    location /api/gallery/ {
        proxy_pass ${GALLERY_SERVICE_BASE}/api/;
        proxy_set_header Host ${GALLERY_SERVICE_HOST};
        proxy_ssl_server_name on;
    }

    location /api/stats {
        proxy_pass ${STATS_URL};
        proxy_set_header Host fullstack-cloudit-stats.azurewebsites.net;
        proxy_ssl_server_name on;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
